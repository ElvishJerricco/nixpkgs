From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Will Fancher <elvishjerricco@gmail.com>
Date: Thu, 15 Dec 2022 21:04:44 -0500
Subject: [PATCH] sysroot: Support x-systemd.growfs

---
 src/fstab-generator/fstab-generator.c | 16 +++++++++++-----
 1 file changed, 11 insertions(+), 5 deletions(-)

diff --git a/src/fstab-generator/fstab-generator.c b/src/fstab-generator/fstab-generator.c
index bca2f389c4..ce3ddec6d8 100644
--- a/src/fstab-generator/fstab-generator.c
+++ b/src/fstab-generator/fstab-generator.c
@@ -824,7 +824,7 @@ static int sysroot_is_nfsroot(void) {
 static int add_sysroot_mount(void) {
         _cleanup_free_ char *what = NULL;
         const char *opts, *fstype;
-        bool default_rw, makefs;
+        bool default_rw, makefs, growfs;
         MountPointFlags flags;
         int r;
 
@@ -901,7 +901,10 @@ static int add_sysroot_mount(void) {
         }
 
         makefs = fstab_test_option(opts, "x-systemd.makefs\0");
-        flags = makefs * MOUNT_MAKEFS;
+        growfs = fstab_test_option(opts, "x-systemd.growfs\0");
+
+        flags = makefs * MOUNT_MAKEFS |
+                growfs * MOUNT_GROWFS;
 
         return add_mount("/proc/cmdline",
                          arg_dest,
@@ -911,14 +914,14 @@ static int add_sysroot_mount(void) {
                          fstype,
                          opts,
                          is_device_path(what) ? 1 : 0, /* passno */
-                         flags,                        /* makefs, growfs off, noauto off, nofail off, automount off */
+                         flags,                        /* makefs, growfs, noauto off, nofail off, automount off */
                          SPECIAL_INITRD_ROOT_FS_TARGET);
 }
 
 static int add_sysroot_usr_mount(void) {
         _cleanup_free_ char *what = NULL;
         const char *opts;
-        bool makefs;
+        bool makefs, growfs;
         MountPointFlags flags;
         int r;
 
@@ -986,7 +989,10 @@ static int add_sysroot_usr_mount(void) {
         log_debug("Found entry what=%s where=/sysusr/usr type=%s opts=%s", what, strna(arg_usr_fstype), strempty(opts));
 
         makefs = fstab_test_option(opts, "x-systemd.makefs\0");
-        flags = makefs * MOUNT_MAKEFS;
+        growfs = fstab_test_option(opts, "x-systemd.makefs\0");
+
+        flags = makefs * MOUNT_MAKEFS |
+                growfs * MOUNT_GROWFS;
 
         r = add_mount("/proc/cmdline",
                       arg_dest,
